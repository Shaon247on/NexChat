# REST base URL. Server-only — the browser never talks to this directly, it goes
# through the BFF proxy at /api/bff/* so the JWT stays in an httpOnly cookie.
CHAT_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.io connects to the HOST ROOT, not /api — Socket.io serves itself at
# /socket.io/. Pointing this at /api yields a handshake 404.
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com
